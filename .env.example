# Copiá este archivo a .env y completá los valores. El .env no se commitea.

# Secreto para firmar los JWT: cualquier texto largo y aleatorio.
JWT_SECRET=

# Clave de la API de Gemini (https://aistudio.google.com/apikey).
GOOGLE_API_KEY=

# Clave de OpenWeatherMap (https://openweathermap.org/api).
OPENWEATHER_API_KEY=

# Token de tu bot de Telegram, creado con @BotFather. Sin él, la API arranca sin el bot ni el scheduler.
TELEGRAM_BOT_TOKEN=

# Opcional: ruta del archivo SQLite (por defecto, runia.db).
# RUNIA_DB_PATH=runia.db
